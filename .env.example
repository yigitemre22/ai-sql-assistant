DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_sql_assistant

# Read-only user for AI-generated SQL
DB_USER=ai_readonly
DB_PASSWORD=your_readonly_password_here

# Migration user for Alembic
MIGRATION_DB_USER=your_migration_user_here
MIGRATION_DB_PASSWORD=your_migration_password_here

# Application user for conversation history
APP_DB_USER=ai_app
APP_DB_PASSWORD=your_app_password_here

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here